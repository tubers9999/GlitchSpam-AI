<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/window_root"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_window"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header bar -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/status_led"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_badge" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="GLITCH SPAMMER • HUD"
            android:textColor="@color/glitch_red"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_minimize"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="—"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/glitch_red"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/cyber_card_stroke" />

    <!-- Live Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_hud_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Status: IDLE"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_hud_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sent: 0 | Speed: 0/s"
            android:textColor="@color/cyber_cyan"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Master Start / Stop Button -->
    <Button
        android:id="@+id/btn_toggle_active"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_neon_button"
        android:text="⚡ START AUTO-ROAST &amp; SPAM"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Target Filter -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="TARGET TRIGGER (Leave blank for ANY message):"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_target_filter"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_edit_text"
        android:hint="e.g. user name or specific phrase"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="11sp" />

    <!-- Mode and Speed Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cb_turbo_spam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/glitch_red"
            android:text="Turbo Spam"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_speed_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Delay: 300ms"
            android:textColor="@color/cyber_cyan"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_instant_roast"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_neon_button_cyan"
            android:text="🔥 FORCE ROAST"
            android:textColor="@color/cyber_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_clear_counter"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_edit_text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="RESET"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="© redglitchx • Universal Injector"
        android:textColor="@color/text_muted"
        android:textSize="9sp" />

</LinearLayout>
