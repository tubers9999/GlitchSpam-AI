<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/window_root"
    android:layout_width="290dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_bar"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Compact Floating Bar Header Row -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="6dp">

        <View
            android:id="@+id/status_led"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_status_dot_idle" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Glitch"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Quick Reply Action Button -->
        <TextView
            android:id="@+id/btn_instant_roast"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_bar_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Reply"
            android:textColor="@color/button_primary_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Master Active Toggle Button -->
        <TextView
            android:id="@+id/btn_toggle_active"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_bar_button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Paused"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <!-- Expand Settings Toggle -->
        <TextView
            android:id="@+id/btn_expand_settings"
            android:layout_width="26dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <!-- Minimize to Bubble -->
        <TextView
            android:id="@+id/btn_minimize"
            android:layout_width="22dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="—"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <!-- Close Entire Overlay -->
        <TextView
            android:id="@+id/btn_close"
            android:layout_width="22dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Expandable Settings & Stats Tray (Hidden by default) -->
    <LinearLayout
        android:id="@+id/layout_settings_tray"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="8dp"
            android:background="@color/cyber_card_stroke" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_hud_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Status: Ready"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_hud_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Count: 0"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_target_filter"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_edit_text"
            android:hint="Trigger keyword (optional)"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cb_turbo_spam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/white"
                android:text="Burst"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_clear_counter"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/bg_bar_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Reset"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
